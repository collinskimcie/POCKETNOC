	</api>
	<view extends="lv_button" width="108" height="54" style_radius="12" style_shadow_width="0" style_pad_all="0" style_bg_color="#c_card">
		<style name="style_pn_pressed" selector="pressed" />
		<lv_obj width="4" height="30" align="left_mid" x="6" scrollable="false" clickable="false" style_radius="2" style_border_width="0" style_bg_opa="100%" style_bg_color="$group_color" />
		<lv_label text="$title" align="left_mid" x="16" width="86" long_mode="wrap" style_text_font="font_14" style_text_color="#c_text" />
	</view>
</component>
